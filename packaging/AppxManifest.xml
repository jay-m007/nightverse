<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store.
  Before submitting, replace the three IDENTITY values with the ones from
  Partner Center → your app → Product management → Product identity
  (build-msix.ps1 does this for you with -IdentityName / -Publisher / -PublisherDisplayName).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="$IDENTITY_NAME$"
    Publisher="$PUBLISHER$"
    Version="$VERSION$"
    ProcessorArchitecture="$ARCH$" />

  <Properties>
    <DisplayName>Nightverse</DisplayName>
    <PublisherDisplayName>$PUBLISHER_DISPLAY_NAME$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Animated, synced lyrics and screen glow for whatever you're playing.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Nightverse" Executable="Nightverse.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Nightverse"
        Description="Animated, synced lyrics and screen glow for whatever you're playing."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" Square310x310Logo="Assets\LargeTile.png" ShortName="Nightverse" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#08060E" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="Nightverse.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="NightverseStartup" Enabled="false" DisplayName="Nightverse" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
